# Strava API credentials. See README.md, section "Strava API access".
# Format is compatible with `docker run --env-file`: no quotes, no `export`.

# Client ID and Client Secret from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret

# Refresh token with scopes activity:read_all,activity:write.
# Used only on the first run, when the token file does not exist yet.
STRAVA_REFRESH_TOKEN=your_refresh_token
